# ---------- Database ----------
POSTGRES_USER=cube
# Must be URL-safe (letters, digits, _ - only): it is interpolated into
# DATABASE_URL / MIGRATION_DATABASE_URL. Percent-encode anything else.
POSTGRES_PASSWORD=cube_dev_password
POSTGRES_DB=cube_hrms
POSTGRES_PORT=5433
# Least-privilege role the API runs as (RLS is bypassed for superusers).
APP_DB_USER=cube_app
APP_DB_PASSWORD=cube_app_dev_password

# ---------- Backend ----------
DATABASE_URL=postgresql+asyncpg://cube_app:cube_app_dev_password@127.0.0.1:5433/cube_hrms
# Owner connection used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://cube:cube_dev_password@127.0.0.1:5433/cube_hrms
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=dev-only-secret-change-me
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:5173"]

# ---------- Storage (Wave 2) ----------
MINIO_ENDPOINT=127.0.0.1:9010
MINIO_ACCESS_KEY=cube
MINIO_SECRET_KEY=cube_dev_secret
MINIO_BUCKET=cube-files

# ---------- AI (Wave 4) ----------
OPENAI_API_KEY=

# ---------- Frontend ----------
VITE_API_BASE_URL=/api/v1
